import Base
import ../defs.bend as D

# Spot checks: both sides of laws on small values. Nat is unary, so large
# numbers are compared as words, and laws whose sides mention 2^32 are not
# evaluated here.

def n(a: U32) -> Nat:
  U32.to_nat(a)

def eqn(a: Nat, b: Nat) -> Bool:
  Nat.is_eq(a, b)

def main() -> List<Bool>:
  [ eqn(n(U32.inc(41)), 42n)
  , eqn(n(U32.add(200, 55)), 255n)
  , eqn(n(U32.sub(9, 4)), Nat.sub(9n, 4n))
  , eqn(n(U32.mul(12, 11)), 132n)
  , eqn(n(U32.div(17, 5)), Nat.div(17n, 5n))
  , eqn(n(U32.mod(17, 5)), Nat.mod(17n, 5n))
  , eqn(n(U32.div(17, 0)), Nat.div(17n, 0n))
  , eqn(n(U32.mod(17, 0)), Nat.mod(17n, 0n))
  , eqn(n(U32.min(7, 3)), Nat.min(7n, 3n))
  , eqn(n(U32.max(7, 3)), Nat.max(7n, 3n))
  , eqn(n(U32.shr(201)), Nat.div(201n, 2n))
  , eqn(n(U32.shrn(1000, 3n)), Nat.div(1000n, Nat.pow(2n, 3n)))
  , eqn(n(U32.shln(5, 4n)), Nat.mul(5n, Nat.pow(2n, 4n)))
  , eqn(n(U32.and(1000, 255)), Nat.mod(1000n, Nat.pow(2n, 8n)))
  , eqn(n(U32.and(1003, 3)), Nat.mod(1003n, 4n))
  , eqn(n(U32.and(77, 0)), Nat.mod(77n, 1n))
  , eqn(n(U32.or(768, 5)), Nat.add(768n, 5n))
  , eqn(n(U32.xor(768, 5)), Nat.add(768n, 5n))
  , Bool.not(Bool.xor(U32.is_gt(2, 1), Nat.is_gt(2n, 1n)))
  , Bool.not(Bool.xor(U32.is_ge(1, 1), Nat.is_ge(1n, 1n)))
  , Bool.not(Bool.xor(U32.is_lt(3, 1), Nat.is_lt(3n, 1n)))
  , eqn(n(D.byte(513, 1n)), 2n)
  , eqn(n(D.byte(513, 0n)), 1n)
  , eqn(n(D.byte(513, 5n)), 0n)
  , eqn(n(D.put_byte(513, 1n, 3)), 769n)
  , eqn(n(D.byte(D.put_byte(513, 2n, 9), 2n)), 9n)
  , eqn(n(D.byte(D.put_byte(513, 2n, 9), 0n)), 1n)
  , U32.is_eq(D.pack4(1, 2, 3, 4), 67305985)
  , eqn(n(D.byte(D.pack4(1, 2, 3, 4), 3n)), 4n)
  , U32.is_eq(D.pack4(D.byte(67305985, 0n), D.byte(67305985, 1n), D.byte(67305985, 2n), D.byte(67305985, 3n)), 67305985)
  , D.bit(5, 2n)
  , Bool.not(D.bit(5, 1n))
  , Bool.not(D.bit(5, 40n))
  , eqn(Nat.add(Nat.mul(Nat.div(17n, 5n), 5n), Nat.mod(17n, 5n)), 17n)
  , eqn(Nat.add(Nat.mul(Nat.div(17n, 0n), 0n), Nat.mod(17n, 0n)), 17n)
    , U32.is_eq(U32.inc(4294967295), 0)
  , U32.is_eq(U32.sub(0, 1), 4294967295)
  , U32.is_eq(U32.not(0), 4294967295)
  , U32.is_eq(U32.shln(1, 32n), 0)
  , U32.is_eq(U32.shrn(4294967295, 40n), 0)
  , U32.is_eq(D.byte(4294967295, 3n), 255)
  , U32.is_eq(D.put_byte(4294967295, 3n, 0), 16777215)
  , U32.is_eq(D.put_byte(513, 4n, 7), 513)
  , U32.is_eq(D.pack4(255, 255, 255, 255), 4294967295)
  , U32.is_eq(D.byte(D.pack4(9, 8, 7, 6), 2n), D.nth4(2n, 9, 8, 7, 6))
  , U32.is_eq(D.merge(67305985, 134678021, 1n), 84148994)
  , U32.is_eq(D.merge(67305985, 134678021, 0n), 67305985)
  , U32.is_eq(D.merge(67305985, 134678021, 4n), 134678021)
  , U32.is_eq(D.byte(D.merge(67305985, 134678021, 3n), 1n), D.byte(134678021, 0n))
  , U32.is_eq(D.zb(16843008), 2155905152)
  , U32.is_eq(D.zb(16843009), 0)
  , U32.is_eq(D.zb(4294967295), 0)
  , Bool.not(U32.is_zero(D.zb(33685760)))
  , U32.is_zero(D.zb(U32.xor(1684234849, D.bcast(10))))
  , Bool.not(U32.is_zero(D.zb(U32.xor(1684212321, D.bcast(10)))))
  , U32.is_eq(D.byte(U32.shln(84148994, 16n), 3n), D.byte(84148994, 1n))
  , U32.is_eq(D.byte(U32.shln(84148994, 16n), 1n), 0)
  , U32.is_eq(D.byte(U32.not(84148994), 2n), U32.xor(D.byte(84148994, 2n), 255))
  , U32.is_zero(U32.xor(77, 77))
  ]
